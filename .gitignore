# ── build outputs (shipped as GitHub Releases, not source) ──
desktop/dist/
desktop/node_modules/
android/build/
android/zyraxon.apk
android/zyraxon.apk.idsig
android/app/src/main/assets/

# ── marketing page + runtime-fetched engines (not needed to build) ──
public/shots/
public/vendor/transformers/
# The background clips and character animations ARE the app, so they are
# tracked: CI has to be able to build an installer that actually plays them.
public/assets/bg/*.part

# ── runtime data (grown on the user's machine, never shipped) ──
data/sites/
data/browser-profile/
data/tts/
data/workspace/
data/stt/
data/tests/
data/*.db
data/*.sqlite
data/model-health.json
*.log

# ── tooling ──
.venv/
__pycache__/
*.pyc
.DS_Store
.agent_tmp/
node_modules/
sites/
