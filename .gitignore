# Release signing material and build artifacts must never be committed.
*.jks
*.keystore
/dist

# A local build output folder. `.apk` files belong in a release, not in the
# tree: a 43 MB debug build sat here once and made every clone pay for it.
/.build-outputs

# Python bytecode from the helper scripts under tools/
__pycache__/
*.pyc

# The sealed assets are generated into the build, never committed.
/app/build/generated/sealedAssets/
nohup.out
