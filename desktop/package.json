{
  "name": "zyraxon-desktop",
  "productName": "ZYRAXON",
  "version": "1.1.0",
  "description": "ZYRAXON — বাংলা মোবাইল/ডেস্কটপ AI অ্যাসিস্ট্যান্ট (Windows, macOS, Linux)",
  "main": "main.cjs",
  "private": true,
  "author": {
    "name": "ZYRAXON",
    "email": "hello@zyraxon.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zyraxon/zyraxon.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "ZYRAXON_SELFTEST=1 electron .",
    "dist": "electron-builder --win --mac --linux",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.zyraxon.desktop",
    "productName": "ZYRAXON",
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../public",
        "to": "public",
        "filter": [
          "**/*",
          "!shots/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ZYRAXON-Setup-${version}.exe",
      "icon": "../build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "ZYRAXON-${version}-mac.${ext}",
      "icon": "../build/icons/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "ZYRAXON-${version}.${ext}",
      "icon": "../build/icons",
      "desktop": {
        "Name": "ZYRAXON",
        "Comment": "বাংলা AI অ্যাসিস্ট্যান্ট",
        "Categories": "Utility;"
      }
    },
    "directories": {
      "buildResources": "../build/icons",
      "output": "dist"
    }
  }
}
