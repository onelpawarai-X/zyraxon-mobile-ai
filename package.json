{
  "name": "zyraxon-mobile-assistant",
  "version": "19.0.7",
  "private": true,
  "type": "module",
  "description": "ZYRAXON — a real mobile AI assistant: realtime SSE chat, Bangla TTS, real tool calling, todo-driven autonomy, publishable websites.",
  "scripts": {
    "start": "node zyraxon.mjs",
    "serve": "node server/server.mjs",
    "build": "node scripts/build-web.mjs",
    "build:watch": "node scripts/build-web.mjs --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "node scripts/build-web.mjs",
    "test": "node test/e2e.mjs",
    "test:voice": "node test/bridgecheck.mjs",
    "test:media": "node test/mediaperf.mjs",
    "test:typing": "node test/typing.mjs",
    "test:perf": "node test/perfattr.mjs",
    "test:version": "node test/versioncheck.mjs",
    "optimize:media": "bash scripts/optimize-media.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "zyraxon.mjs",
  "bin": {
    "zyraxon": "zyraxon.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
