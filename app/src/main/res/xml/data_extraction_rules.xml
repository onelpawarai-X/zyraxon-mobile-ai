<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ equivalent of backup_rules.xml: nothing leaves the device.

   Chats live in the Room database and the cloud agent token and provider keys
   live in SharedPreferences, so both are excluded from cloud backup and from
   device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
