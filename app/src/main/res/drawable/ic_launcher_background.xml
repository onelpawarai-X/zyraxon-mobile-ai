<?xml version="1.0" encoding="utf-8"?>
<!-- ZYRAXON launcher background: deep indigo to violet, matching the aura. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF120A28" />
                <item android:offset="0.55" android:color="#FF241046" />
                <item android:offset="1" android:color="#FF3A0C58" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Soft central bloom so the icon has depth rather than a flat fill. -->
    <path android:pathData="M54,54m-32,0a32,32 0,1 1,64 0a32,32 0,1 1,-64 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="54"
                android:gradientRadius="32">
                <item android:offset="0" android:color="#5522D3EE" />
                <item android:offset="1" android:color="#0022D3EE" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
